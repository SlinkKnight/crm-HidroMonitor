@import url('https://fonts.googleapis.com/css2?family=Georama:wght@700;800&family=Inter:wght@400;500;600;700&display=swap');

/* Fonte da marca: XXII Geom Bold.
   Coloque o arquivo em static/fonts/ como XXIIGeom-Bold.woff2 (ou .woff/.otf/.ttf).
   Se ela estiver instalada no computador, também é achada pelo nome.
   Sem o arquivo, cai em Poppins Bold (incluída, de desenho geométrico parecido). */
@font-face {
  font-family: "XXII Geom";
  font-weight: 700;
  font-style: normal;
  font-display: swap;
  src: local("XXII Geom Bold"), local("XXIIGeom-Bold"), local("XXII Geom"),
       url("fonts/XXIIGeom-Bold.woff2") format("woff2"),
       url("fonts/XXIIGeom-Bold.woff") format("woff"),
       url("fonts/XXIIGeom-Bold.otf") format("opentype"),
       url("fonts/XXIIGeom-Bold.ttf") format("truetype"),
       url("fonts/Poppins-Bold.ttf") format("truetype");
}

:root {
  --profundo: #123B8C;
  --fluxo: #229BF0;
  --nevoa: #EDF4FC;
  --ambar: #FFB020;
  --texto: #0B1F44;
  --suave: #4A5F85;
  --borda: #CFE0F5;
}

* { box-sizing: border-box; }
body {
  margin: 0; background: var(--nevoa); color: var(--texto);
  font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
}
h1, h2, h3 { margin: 0; }
button, input, select, textarea { font: inherit; }

/* topo e identidade visual */
.topo {
  background: var(--profundo); color: #fff;
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 28px;
}
.topo .logo-container {
  display: flex; align-items: center; gap: 10px;
}
.topo .logo-icon {
  width: 28px; height: 28px;
}

.topo .logo-icon-img {
width: 44px;
height: 44px;
/* filter: brightness(0) invert(1); */
object-fit: contain;
}

/* fundo branco para a seta azul-escura da logo não sumir no topo azul */
.topo .logo-img {
  height: 44px; width: auto; display: block;
  background: #fff; border-radius: 12px; padding: 5px;
}

.logo-text {
  font-family: "XXII Geom", "Poppins", system-ui, sans-serif;
  font-weight: 700; font-size: 22px; letter-spacing: -0.2px; line-height: 1;
  white-space: nowrap;
}
.topo .brand-hidro { color: #f3f3f3; -webkit-text-stroke: 0.5px #ffffff; color: #ffffff; }
.topo .brand-dot { color: #fff; margin: 0 4px; opacity: 0.6; }
.topo .brand-crm { color: var(--ambar); font-weight: 700; }
.topo a { color: #fff; opacity: .8; text-decoration: none; font-size: 14px; }
.topo a:hover { opacity: 1; }

.wrap { max-width: 1100px; margin: 0 auto; padding: 28px 20px 60px; }

/* barra de ações */
.acoes {
  display: flex; gap: 12px; flex-wrap: wrap; align-items: center;
  margin-bottom: 18px;
}
.btn {
  border: 0; border-radius: 10px; padding: 11px 18px; cursor: pointer;
  font-weight: 600; background: var(--ambar); color: var(--texto);
}
.btn:hover { filter: brightness(.96); }
.btn.sec { background: #fff; border: 1px solid var(--borda); color: var(--profundo); }
.btn.azul { background: var(--profundo); color: #fff; }
.btn.perigo { background: #fff; color: #B42318; border: 1px solid #F3C4BF; }
.busca {
  flex: 1; min-width: 200px; padding: 11px 14px; border-radius: 10px;
  border: 1px solid var(--borda); background: #fff;
}

/* filtros de tags */
.filtros-tags {
  display: flex; flex-direction: column; gap: 10px; margin-bottom: 18px;
  background: #fff; padding: 14px; border-radius: 12px; border: 1px solid var(--borda);
}
.grupo-filtro {
  display: flex; align-items: center; gap: 12px;
}
.grupo-filtro > span {
  font-size: 13px; font-weight: 600; color: var(--suave); min-width: 80px;
}
.abas { display: flex; gap: 8px; flex-wrap: wrap; }
.aba {
  border: 1px solid var(--borda); background: var(--nevoa); color: var(--suave);
  padding: 6px 12px; border-radius: 999px; cursor: pointer; font-size: 13px;
}
.aba.ativa { background: var(--fluxo); border-color: var(--fluxo); color: #fff; }
.aba small { opacity: .8; margin-left: 2px; }

/* tabela */
.cartao {
  background: #fff; border: 1px solid var(--borda); border-radius: 14px;
  overflow: hidden;
}
table { width: 100%; border-collapse: collapse; }
th {
  text-align: left; font-size: 12px; text-transform: uppercase;
  letter-spacing: .6px; color: var(--suave); background: #F7FAFE;
  padding: 12px 16px; border-bottom: 1px solid var(--borda);
}
td { padding: 13px 16px; border-bottom: 1px solid #EEF3FA; font-size: 14px; vertical-align: top; }
tr:last-child td { border-bottom: 0; }

/* sistema de cores das tags: --bg fundo suave, --fg texto, --solid cor cheia */
.c-azul     { --bg: #DCE6F8; --fg: #123B8C; --solid: #123B8C; }
.c-ciano    { --bg: #DDF0FE; --fg: #0F5C99; --solid: #229BF0; }
.c-ambar    { --bg: #FFF0CC; --fg: #7A4F00; --solid: #FFB020; }
.c-verde    { --bg: #DDF5E6; --fg: #146C3B; --solid: #1F9D55; }
.c-vermelho { --bg: #FDE4E1; --fg: #A32A1D; --solid: #D64534; }
.c-roxo     { --bg: #ECE5FA; --fg: #5B32A8; --solid: #7C4DCC; }
.c-teal     { --bg: #D9F3F1; --fg: #0B6B66; --solid: #14A39B; }
.c-cinza    { --bg: #E8EDF4; --fg: #3E4C63; --solid: #6B7A90; }

.tag {
  display: inline-block; padding: 3px 10px; border-radius: 999px;
  font-size: 12px; font-weight: 600; margin: 2px;
  background: var(--bg, #E8EDF4); color: var(--fg, #3E4C63);
}

.mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px; color: var(--suave); }
.vazio { padding: 48px; text-align: center; color: var(--suave); }
.linha-acoes { display: flex; gap: 6px; }
.linha-acoes button { padding: 6px 10px; font-size: 13px; }

/* modal */
.fundo {
  position: fixed; inset: 0; background: rgba(11, 31, 68, .5);
  display: none; align-items: center; justify-content: center; padding: 16px; z-index: 100;
}
.fundo.aberto { display: flex; }
.modal {
  background: #fff; border-radius: 16px; width: 100%; max-width: 520px;
  padding: 24px; max-height: 92vh; overflow: auto;
}
.modal h2 { color: var(--profundo); margin-bottom: 16px; }
.grade { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.grade .full { grid-column: 1 / -1; }
label { display: block; font-size: 13px; color: var(--suave); margin-bottom: 4px; }
.modal input, .modal select, .modal textarea, .login input {
  width: 100%; padding: 10px 12px; border: 1px solid var(--borda);
  border-radius: 9px; background: #fff; color: var(--texto);
}
.modal textarea { min-height: 80px; resize: vertical; }

.checkbox-group {
  display: flex; flex-wrap: wrap; gap: 8px; border: 1px solid var(--borda);
  padding: 10px; border-radius: 9px; max-height: 120px; overflow-y: auto;
}
.check-item {
  display: flex; align-items: center; gap: 6px; font-size: 13px; margin: 0;
  background: #fff; color: var(--suave); border: 1px solid var(--borda);
  padding: 4px 10px; border-radius: 999px; cursor: pointer;
}
.check-item input { width: auto; accent-color: var(--solid, var(--profundo)); }
.check-item:has(input:checked) {
  background: var(--bg); color: var(--fg); border-color: var(--solid); font-weight: 600;
}

/* gerenciar tags */
.nova-tag { margin-bottom: 18px; }
.nova-tag-linha { display: flex; gap: 8px; margin-bottom: 10px; }
.nova-tag-linha input { flex: 1; }
.sub { font-size: 13px; text-transform: uppercase; letter-spacing: .6px; color: var(--suave); margin-bottom: 8px; }
.swatches { display: flex; gap: 8px; flex-wrap: wrap; }
.swatch {
  width: 24px; height: 24px; border-radius: 50%; border: 2px solid #fff;
  background: var(--solid); cursor: pointer; padding: 0;
  box-shadow: 0 0 0 1px var(--borda);
}
.swatch.on { box-shadow: 0 0 0 2px var(--texto); }
.swatches.pequeno { gap: 5px; }
.swatches.pequeno .swatch { width: 16px; height: 16px; border-width: 1px; }
.lista-tags { border: 1px solid var(--borda); border-radius: 10px; max-height: 280px; overflow-y: auto; }
.tag-row {
  display: flex; align-items: center; gap: 12px;
  padding: 9px 12px; border-bottom: 1px solid #EEF3FA;
}
.tag-row:last-child { border-bottom: 0; }
.tag-info { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 3px; }
.tag-info .tag { margin: 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tag-row .btn { padding: 5px 10px; font-size: 12px; flex: none; }
.tag-row .swatches { flex: none; }
@media (max-width: 520px) {
  .tag-row { flex-wrap: wrap; }
  .tag-info { flex-basis: 100%; }
}
.lista-tags .vazio { padding: 20px; }

.rodape { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }

/* api */
.api {
  margin-top: 28px; background: var(--profundo); color: #DCE8FA;
  border-radius: 14px; padding: 20px 22px; font-size: 14px;
}
.api h3 { color: #fff; margin-bottom: 8px; }
.api pre {
  background: rgba(255,255,255,.08); padding: 12px; border-radius: 10px;
  overflow-x: auto; margin: 8px 0;
  font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12.5px;
}

/* login: painel da marca à esquerda, formulário à direita */
.login-pag { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
.login-marca {
  background: var(--profundo); color: #fff; padding: 48px;
  display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 28px;
  position: relative; overflow: hidden;
}
.login-marca::after {            /* curva de assinatura, em azul fluxo */
  content: ""; position: absolute; right: -140px; bottom: -140px;
  width: 380px; height: 380px; border-radius: 50%;
  border: 44px solid var(--fluxo); opacity: .25;
}
.login-logo {
  background: #fff; border-radius: 22px; padding: 16px;
  display: grid; place-items: center;
}
.login-logo img { height: 84px; width: auto; display: block; }
.login-marca .logo-text { font-size: 40px; }
.login-marca .brand-hidro { color: #fff; }
.login-marca .brand-monitor { color: #fff; }
.login-marca .brand-dot { color: var(--fluxo); margin: 0 8px; }
.login-marca .brand-crm { color: var(--ambar); }
.login-marca p { margin: 0; max-width: 340px; color: #C9D9F3; font-size: 16px; line-height: 1.5; position: relative; z-index: 1; }

.login-form { display: grid; place-items: center; padding: 32px 24px; background: var(--nevoa); }
.login {
  background: #fff; border: 1px solid var(--borda); border-radius: 16px;
  padding: 32px; width: 100%; max-width: 380px;
}
.login h1 { font-size: 22px; color: var(--profundo); margin-bottom: 4px; }
.login .sub-login { color: var(--suave); margin: 0 0 22px; font-size: 14px; }
.login .campo { margin-bottom: 14px; }
.login input:focus { outline: 2px solid var(--fluxo); outline-offset: -1px; }
.login .btn { width: 100%; margin-top: 6px; }
.login .btn:focus-visible { outline: 3px solid var(--fluxo); outline-offset: 2px; }
.erro { background: #FDECEA; color: #B42318; padding: 9px 12px; border-radius: 9px; margin-bottom: 14px; font-size: 14px; }

@media (max-width: 820px) {
  .login-pag { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
  .login-marca { padding: 28px 24px; flex-direction: row; align-items: center; gap: 14px; }
  .login-marca p, .login-marca::after { display: none; }
  .login-logo { padding: 8px; border-radius: 14px; }
  .login-logo img { height: 40px; }
  .login-marca .logo-text { font-size: 22px; }
}

@media (max-width: 720px) {
  .esconde-m { display: none; }
  .grade { grid-template-columns: 1fr; }
  th, td { padding: 10px; }
  .grupo-filtro { flex-direction: column; align-items: flex-start; }
}